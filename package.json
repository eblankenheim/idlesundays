{
  "name": "idlesundays",
  "version": "0.2.0",
  "description": "Idle Sundays - Car Meet Events",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync": "aws s3 sync ./out s3://idlesundays.com/",
    "invalidate": "aws cloudfront create-invalidation --distribution-id E3I0XZQFYFEILP --paths /*",
    "deploy": "npm run build && npm run sync && npm run invalidate",
    "test": "jest",
    "clean": "rm -rf .next out node_modules package-lock.json",
    "reinstall": "npm cache clean --force && npm install"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.9.2",
    "next": "^15.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
